# Apptainer definition file for this environment.
#
# Build:  apptainer build container.sif container.def
#
# The container packages everything a scientist agent needs to work on
# this paper's task. The agent's workspace is bind-mounted at /home/user
# at runtime — it is NOT baked into the container.
#
# Security boundary:
#   - test_labels and test_final_state.py NEVER enter the container
#   - solution/ NEVER enters the container
#   - Only training data and test features are included
#
# *** IMPORTANT ***
# Python packages (torch, transformers, etc.) go in setup.sh, NOT here.
# Only OS-level packages (apt-get) belong in %post.
# Putting pip install in %post is the #1 cause of build failures.

# --- CPU-only base (default) ---
Bootstrap: docker
From: python:3.11-slim

# --- GPU / CUDA base (uncomment if your paper needs GPU) ---
# Bootstrap: docker
# From: nvidia/cuda:12.1.0-runtime-ubuntu22.04
# Use 'runtime' (~1 GB) unless you need to compile CUDA code,
# in which case use 'devel' (~4 GB).

%files
    # Road network data
    data/downloads/road-usroads-48.mtx /home/user/data/downloads/road-usroads-48.mtx
    data/downloads/roadNet-PA.txt /home/user/data/downloads/roadNet-PA.txt
    data/loader.py /home/user/data/loader.py
    data/graph.py /home/user/data/graph.py

    # Experiment code
    method/sul_tree.py /home/user/method/sul_tree.py
    method/col_tree.py /home/user/method/col_tree.py
    method/baselines.py /home/user/method/baselines.py
    method/graph.py /home/user/method/graph.py
    method/experiment.py /home/user/method/experiment.py

    # Evaluation code
    eval/evaluate.py /home/user/eval/evaluate.py

    # Scripts
    scripts/download.sh /home/user/scripts/download.sh
    scripts/evaluate.sh /home/user/scripts/evaluate.sh
    scripts/reproduce.sh /home/user/scripts/reproduce.sh
    scripts/baseline.sh /home/user/scripts/baseline.sh

    # Scoring
    scoring/reference.json /home/user/scoring/reference.json
    scoring/scores.json /home/user/scoring/scores.json
    scoring/TARGETS.md /home/user/scoring/TARGETS.md
    scoring/CONSTRAINTS.md /home/user/scoring/CONSTRAINTS.md
    scoring/DIRECTION.md /home/user/scoring/DIRECTION.md

%post
    apt-get update && apt-get install -y --no-install-recommends \
        tmux nano vim-tiny less curl wget git && \
    ln -sf /usr/bin/vim.tiny /usr/bin/vim && \
    rm -rf /var/lib/apt/lists/*

    # If using the CUDA base image (which lacks Python), uncomment:
    # apt-get update && apt-get install -y --no-install-recommends \
    #     python3 python3-pip python3-dev \
    #     libomp-dev libgl1-mesa-glx libglib2.0-0 \
    #     tmux nano vim-tiny less curl wget git && \
    # ln -sf /usr/bin/vim.tiny /usr/bin/vim && \
    # rm -rf /var/lib/apt/lists/*

    # *** DO NOT put pip install here. Use setup.sh instead. ***

    mkdir -p /home/user/data/downloads
    chmod 755 /home/user


    # --- Merged from setup.sh ---
    pip install --break-system-packages uv 2>/dev/null || pip install uv 2>/dev/null || true
    export UV_SYSTEM_PYTHON=1 UV_BREAK_SYSTEM_PACKAGES=1
    # Install Python packages into the container overlay.
    #
    # This script is run by the system on the login node (which has internet)
    # inside the container with a persistent overlay. Changes persist across
    # job submissions without rebuilding the container.
    #
    # Put ALL pip installs here, NOT in container.def.
    # Only use container.def for the base Docker image and apt-get packages.
    
    # *** IMPORTANT: Install into the SYSTEM Python, not a virtual environment.
    # The overlay may be recreated on container rebuilds — a venv inside
    # it will be lost and all subsequent jobs will fail.
    # Use: uv pip install --system <packages>
    # Do NOT create a venv (python -m venv, virtualenv, etc.).
    
    set -e
    
    # No additional pip packages needed — uses only Python standard library.
    # Required packages (heapq, bisect, random, json, time, argparse) are all stdlib.

%environment
    export HOME=/home/user
    export PYTHONUNBUFFERED=1
